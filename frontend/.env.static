# 정적 사이트 빌드 설정 — `npm run build:static` (= vite build --mode static) 이 읽는다.
#
# 왜 파일인가: 윈도우에서 환경변수를 셸마다 다르게 넘기다 보면(cmd 의 set,
# PowerShell 의 $env:, npm 스크립트의 cross-env) 어느 하나에서 조용히 빠진다.
# 그러면 정적 모드가 아닌 채로 빌드돼 백엔드를 찾다가 전부 실패한다.
# Vite 의 `--mode static` 은 이 파일을 확실히 읽으므로 셸에 의존하지 않는다.

# 백엔드 대신 public/snapshot 의 JSON 을 읽는다.
VITE_DATA_MODE=static

# GitHub Pages 는 https://<user>.github.io/<repo>/ 하위에 올라간다.
# 루트 도메인에 올릴 때는 / 로 바꾼다.
VITE_BASE=/apt-price/

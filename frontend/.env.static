# 정적 사이트 빌드 설정 — `npm run build:static` (= vite build --mode static) 이 읽는다.
#
# 왜 파일인가: 윈도우에서 환경변수를 셸마다 다르게 넘기다 보면(cmd 의 set,
# PowerShell 의 $env:, npm 스크립트의 cross-env) 어느 하나에서 조용히 빠진다.
# 그러면 정적 모드가 아닌 채로 빌드돼 백엔드를 찾다가 전부 실패한다.
# Vite 의 `--mode static` 은 이 파일을 확실히 읽으므로 셸에 의존하지 않는다.

# 백엔드 대신 public/snapshot 의 JSON 을 읽는다.
VITE_DATA_MODE=static

# GitHub Pages 는 https://<user>.github.io/<repo>/ 하위에 올라간다.
# 루트 도메인에 올릴 때는 / 로 바꾼다.
VITE_BASE=/apt-price/

# ---------------------------------------------------------------- 지도 탭
#
# 기본은 **끈 상태**다. 지도만 키가 필요하기 때문이다.
#
# 카카오 지도를 띄우려면 JS 키가 번들에 들어가야 한다. App.jsx 가 MapView 를 정적
# import 하므로 kakaoMap.js 의 `import.meta.env.VITE_KAKAO_JS_KEY` 가 그대로
# 인라인된다 — 실제로 확인했다. 지도 탭을 숨겨 둔 상태에서도 .env.local 의 32자
# 키가 dist 번들 안에 들어 있었다. 그래서 여기서 비워 번들에서 빼낸다
# (.env.static 이 .env.local 보다 우선한다).
#
# JS 키는 원래 클라이언트에 노출되는 키라(카카오 지도를 쓰는 모든 사이트의 소스에
# 보인다) 노출 자체가 사고는 아니다. 다만 보호 수단인 도메인 허용목록이 Referer
# 기반이라 우회가 불가능하지는 않다. 그러니 켜는 것을 의도적인 행위로 둔다.
#
# ## 지도를 켜려면
#
# `frontend/.env.static.local` 을 만들고(gitignore 의 .env*.local 에 걸린다):
#
#     VITE_KAKAO_JS_KEY=<발급받은 JS 키>
#     VITE_STATIC_MAP=1
#
# .local 은 이 파일보다 우선하므로 둘 다 덮인다. 키를 저장소에 커밋하지 않고도
# 번들에는 들어간다.
#
# 그리고 카카오 개발자센터 > 내 애플리케이션 > 플랫폼 > Web 에 배포 주소를
# 등록해야 한다(예: https://osmin625.github.io). 카카오는 origin 을 완전일치로
# 검사하므로 등록하지 않으면 지도 탭만 설정 안내로 바뀐다.
#
# 백엔드가 지오코딩에 쓰는 KAKAO_REST_KEY 는 **다른 키**이고 backend/.env 에만
# 있다. 이쪽으로는 절대 나가지 않는다.
VITE_KAKAO_JS_KEY=
VITE_STATIC_MAP=

# 공공데이터포털 '국토교통부_아파트 매매 실거래가 상세 자료' 일반 인증키(Decoding)
# https://www.data.go.kr/data/15126468/openapi.do
# 주의: '상세 자료'(15126468)를 신청할 것. 이름이 비슷한 '아파트 매매 실거래가 자료'
# (15126469)는 동 정보와 계약 해제 여부가 없어 이 프로젝트 코드와 맞지 않는다.
MOLIT_SERVICE_KEY=

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
# https://developers.kakao.com
# 단지 POI 수집과 좌표·역 조회에 쓴다. 지도 렌더링용 JavaScript 키는 이것과
# 다른 키이며 frontend/.env.local 의 VITE_KAKAO_JS_KEY 로 들어간다.
# 같은 앱에서 두 키가 함께 발급되므로 앱은 하나만 만들면 된다.
KAKAO_REST_KEY=

# SK open API > 보행자 경로안내. https://openapi.sk.com
# 비워 두면 직선거리×1.25 추정치로 자동 폴백한다(개발은 막히지 않는다).
# 나중에 키를 넣고 scripts/route_walk.py 를 재실행하면 실제 도보 경로로 교체된다.
TMAP_APP_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
